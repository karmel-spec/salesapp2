# ── Brigham Larson Pianos Sales Console — environment ──────────────
# Copy to .env.local for development. Nothing is required to boot:
# with no vars set, the app runs in read-only snapshot mode against
# the Leads Log share link.

# The Leads Log spreadsheet (defaults to the live BLP Leads Log)
SHEET_ID=1sdOeaChihEjAQBCi8U0_lTTlYP4H38eiC6zgmRLoWC0
# SHEET_TAB=            # blank = first tab, autodetected

# ── Two-way sync (Google service account) ──
# 1. Google Cloud Console → create a project → enable "Google Sheets API"
# 2. Create a service account, generate a JSON key
# 3. Share the Leads Log with the service account email as EDITOR
# 4. Paste the values here (keep the \n escapes in the private key)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# ── Team access ──
# Shared passcode gating the whole console (same model as BLP Mega App).
BLP_APP_ACCESS_KEY=
# Shared app-to-app key (same value on the CRM / Client Portal sites). The CRM reads
# /api/board with it so the Inbox Board also shows in the CRM sidebar (11/4).
BLP_INTEGRATION_KEY=

# ── Twilio SMS (approved text drafts send through this) ──
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=     # E.164, e.g. +18017690054 — Karmel is confirming

# ── Calling (Brigham 11/4) ──
# Caller ID customers see on every call (the public store line, verified in Twilio)
# TWILIO_CALLER_ID_NUMBER=+18017010113
# Browser dialer — call from the computer, no cell phone or Plaud:
#  1. Twilio Console → Account → API keys & tokens → Create API key (Standard)
#  2. Twilio Console → Voice → Manage → TwiML Apps → Create: Voice Request URL
#     = POST <PUBLIC_BASE_URL>/api/twilio/outbound   (e.g. https://blpsalesapp.netlify.app/api/twilio/outbound)
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
# Inbound calls to the Twilio number forward here (Voice webhook = /api/twilio/voice)
# TWILIO_FORWARD_NUMBER=
# Transcripts for every recorded call (Whisper, ~$0.006/min); Claude writes the summary
OPENAI_API_KEY=

# ── Email (approved email drafts send from info@) ──
# Google Workspace → info@brighamlarsonpianos.com → App Passwords
SMTP_USER=info@brighamlarsonpianos.com
SMTP_PASS=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
EMAIL_FROM_NAME=Brigham Larson Pianos

# ── Arnold, Chief Sales Agent (Telegram @arnoldlarsonbot / Grok Bot via the Agent Console) ──
# Where "Ask Arnold" and inbound-reply events go: the Agent Console's events route,
# which wakes Arnold's Grok Bot (was his Hermes gateway on the Mac until 2026-10-08)
ARNOLD_WEBHOOK_URL=https://blpagents.netlify.app/api/agents/arnold/events
BLP_AGENTS_URL=https://blpagents.netlify.app
BLP_AGENTS_KEY=              # the console's team passcode (its BLP_APP_ACCESS_KEY) — engine-status probe
ARNOLD_WEBHOOK_SECRET=      # HMAC shared secret for both directions
BLP_ARNOLD_ACCESS_KEY=      # draft-only key Arnold sends in x-blp-key
# Team notifications from Arnold's bot into your sales group chat
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Claude API fallback (drafts in Arnold's voice when the console is unreachable) ──
ANTHROPIC_API_KEY=

# ── Business rules (defaults shown) ──
# STALE_DAYS=30
# DEFAULT_REP=Brigham
# STALE_REP=Arnold
